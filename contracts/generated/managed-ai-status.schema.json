{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "UUID": {
      "type": "string",
      "description": "a Universally Unique Identifier",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    }
  },
  "type": "object",
  "required": [
    "schemaVersion",
    "accountId",
    "available",
    "dailyLimitMicrousd",
    "usedMicrousd",
    "requestLimit",
    "requestsUsed",
    "expiresAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "enum": [
        1
      ]
    },
    "accountId": {
      "$ref": "#/$defs/UUID"
    },
    "available": {
      "type": "boolean"
    },
    "dailyLimitMicrousd": {
      "type": "integer",
      "description": "a number less than or equal to 9007199254740991",
      "title": "lessThanOrEqualTo(9007199254740991)",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "usedMicrousd": {
      "type": "integer",
      "description": "a number less than or equal to 9007199254740991",
      "title": "lessThanOrEqualTo(9007199254740991)",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "requestLimit": {
      "type": "integer",
      "description": "a number less than or equal to 9007199254740991",
      "title": "lessThanOrEqualTo(9007199254740991)",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "requestsUsed": {
      "type": "integer",
      "description": "a number less than or equal to 9007199254740991",
      "title": "lessThanOrEqualTo(9007199254740991)",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expiresAt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}
