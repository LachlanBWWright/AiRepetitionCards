{
  "expo": {
    "name": "Recall",
    "slug": "recall-learning",
    "scheme": "recall",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.recall.study"
    },
    "android": {
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#c4ed68"
      },
      "package": "com.recall.study"
    },
    "plugins": [
      "expo-sqlite",
      "expo-status-bar",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-sharing",
      "expo-notifications"
    ],
    "web": {
      "bundler": "metro"
    }
  }
}
