{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "build": "expo export --platform android --output-dir dist/android && expo export --platform ios --output-dir dist/ios",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint"
  },
  "dependencies": {
    "@recall/application": "workspace:*",
    "@recall/contracts": "workspace:*",
    "@recall/design-tokens": "workspace:*",
    "@recall/domain": "workspace:*",
    "@recall/local-store": "workspace:*",
    "@recall/scheduler": "workspace:*",
    "@recall/sync-core": "workspace:*",
    "@supabase/supabase-js": "2.117.2",
    "effect": "^3.22.2",
    "expo": "~57.0.26",
    "expo-audio": "~57.0.5",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.11",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-sqlite": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "typescript": "^5.0.0"
  }
