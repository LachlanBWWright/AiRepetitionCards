# `pnpm dev:api:next` fills these from local Supabase when they are blank.
# Hosted web study requires a Supabase URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Next.js server proxy upstream and Electron main-process API origin.
# Local default is ASP.NET. Electron uses this as its whole API origin; release
# environments may set a reachable HTTPS API origin or gateway instead.
RECALL_API_URL=http://localhost:5000
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Optional task overrides; blank values use OPENAI_MODEL.
OPENAI_TUTOR_MODEL=
OPENAI_EVALUATION_MODEL=
OPENAI_PROPOSAL_MODEL=

# Optional hosted AI limits; enabling either requires durable Redis REST storage.
# Request limit is at most the existing 30-call daily Supabase ceiling.
AI_DAILY_REQUEST_LIMIT=
# Conservative admission units: complete request bytes + maximum output tokens.
AI_DAILY_TOKEN_BUDGET=
AI_BUDGET_STORE_REST_URL=
AI_BUDGET_STORE_REST_TOKEN=
AI_BUDGET_STORE_PREFIX=recall:ai-budget

# Optional website Sign in with ChatGPT (server only).
OPENAI_SIWC_CLIENT_ID=
OPENAI_SIWC_REDIRECT_URI=http://localhost:3000/auth/openai/callback
OPENAI_SIWC_CLIENT_AUTH_METHOD=none
OPENAI_SIWC_CLIENT_SECRET=
SIWC_STORE_REST_URL=
SIWC_STORE_REST_TOKEN=
SIWC_IDENTITY_KEY_SECRET=
SIWC_STORE_PREFIX=recall:siwc
# Optional eligible open-source desktop distribution; read by Electron main.
RECALL_CHATGPT_LOCAL_ENABLED=false
# Sanitized HTTP operation logs; no identities, content or tokens.
RECALL_HTTP_LOGGING=false

# Local development only. Production defaults to redis when this setting is absent.
API_RATE_LIMIT_MODE=memory
# Set mode=redis and these server-only values for shared request counters.
API_RATE_LIMIT_STORE_REST_URL=
API_RATE_LIMIT_STORE_REST_TOKEN=
API_RATE_LIMIT_STORE_PREFIX=recall:api-rate-limit
# Optional: enable only behind a proxy that overwrites this single-IP header.
# Leave both blank to disable IP buckets. Use a random secret of at least 32 characters.
API_RATE_LIMIT_TRUSTED_IP_HEADER=
API_RATE_LIMIT_IP_HMAC_SECRET=

# Tutor transcript retention and protected scheduled cleanup. 0 disables automatic expiry.
TUTOR_TRANSCRIPT_RETENTION_DAYS=30
TUTOR_RETENTION_JOB_SECRET=
# Vercel sends this separate secret to the scheduled GET endpoint.
CRON_SECRET=
TUTOR_RETENTION_BATCH_SIZE=250
