{
  "name": "recall-learning-platform",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "build": "turbo run build --filter=web",
    "build:mobile": "turbo run build --filter=mobile",
    "dev:desktop": "turbo run dev --filter=desktop",
    "build:desktop": "turbo run build --filter=desktop",
    "package:desktop": "pnpm --filter desktop package",
    "lint": "turbo run lint lint:packages",
    "policy": "node scripts/generate-design-tokens.mjs --check && node scripts/check-policy.mjs && node scripts/check-migrations.mjs",
    "typecheck": "turbo run typecheck",
    "dev:mobile": "pnpm --filter mobile start",
    "format:check": "pnpm --filter web format:check",
    "format:write": "pnpm --filter web format:write",
    "storybook": "pnpm --filter web storybook",
    "build-storybook": "turbo run build-storybook --filter=web",
    "screenshots": "pnpm --filter web screenshots",
    "supabase:start": "pnpm exec supabase start",
    "supabase:stop": "pnpm exec supabase stop",
    "supabase:reset": "pnpm exec supabase db reset",
    "supabase:types": "pnpm exec supabase gen types typescript --local > packages/infra-supabase/src/database.types.ts && pnpm --filter web exec prettier --write ../../packages/infra-supabase/src/database.types.ts",
    "build:all": "turbo run build",
    "lint:packages": "eslint --max-warnings=0 --config packages/eslint.config.mjs packages",
    "tokens:write": "node scripts/generate-design-tokens.mjs",
    "tokens:check": "node scripts/generate-design-tokens.mjs --check",
    "policy:static": "node scripts/generate-design-tokens.mjs --check && node scripts/check-policy.mjs",
    "check:static": "pnpm policy:static && pnpm typecheck && pnpm lint && pnpm format:check && pnpm build:all && pnpm build-storybook",
    "test": "pnpm --filter @recall/verification test",
    "test:integration": "pnpm --filter @recall/verification test:integration",
    "check:pure": "pnpm test && pnpm check:static",
    "check": "pnpm test && pnpm test:integration && pnpm check:static"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "supabase": "2.119.0",
    "typescript-eslint": "^8.71.0",
    "turbo": "2.11.7",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
