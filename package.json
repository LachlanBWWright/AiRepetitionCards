{
  "name": "recall-learning-platform",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "benchmark:collection": "node scripts/run-tooling.mjs pnpm --filter @recall/verification exec node scripts/run-collection-benchmark.mjs",
    "dev": "turbo run dev --filter=web",
    "dev:api:next": "node scripts/dev-with-api.mjs next",
    "build": "node scripts/run-tooling.mjs turbo run build --filter=web --concurrency=1",
    "build:mobile": "node scripts/run-tooling.mjs turbo run build --filter=mobile --concurrency=1",
    "dev:desktop": "turbo run dev --filter=desktop",
    "dev:api:desktop": "node scripts/dev-with-api.mjs desktop",
    "build:desktop": "node scripts/run-tooling.mjs turbo run build --filter=desktop --concurrency=1",
    "package:desktop": "node scripts/run-tooling.mjs pnpm --filter desktop package",
    "lint": "pnpm lint:config && node scripts/run-tooling.mjs turbo run lint lint:packages --concurrency=1",
    "lint:config": "node scripts/check-lint-config.mjs",
    "check:source-limits": "node scripts/check-source-limits.mjs",
    "test:source-limits": "node --test scripts/check-source-limits.test.mjs",
    "policy": "node scripts/generate-design-tokens.mjs --check && node scripts/check-policy.mjs && node scripts/check-migrations.mjs",
    "typecheck": "node scripts/run-tooling.mjs turbo run typecheck --concurrency=1",
    "dev:mobile": "pnpm --filter mobile start",
    "dev:api:mobile": "node scripts/dev-with-api.mjs mobile",
    "format:check": "pnpm --filter web format:check",
    "format:write": "pnpm --filter web format:write",
    "storybook": "pnpm --filter web storybook",
    "build-storybook": "node scripts/run-tooling.mjs turbo run build-storybook --filter=web --concurrency=1",
    "screenshots": "pnpm --filter web screenshots",
    "supabase:start": "pnpm exec supabase start",
    "supabase:stop": "pnpm exec supabase stop",
    "supabase:reset": "pnpm exec supabase db reset",
    "supabase:types": "pnpm exec supabase gen types typescript --local > packages/infra-supabase/src/database.types.ts && pnpm --filter web exec prettier --write ../../packages/infra-supabase/src/database.types.ts",
    "build:all": "node scripts/run-tooling.mjs turbo run build --concurrency=1",
    "lint:packages": "eslint --max-warnings=0 --config packages/eslint.config.mjs packages",
    "tokens:write": "node scripts/generate-design-tokens.mjs",
    "tokens:check": "node scripts/generate-design-tokens.mjs --check",
    "policy:static": "node scripts/generate-design-tokens.mjs --check && node scripts/check-policy.mjs && pnpm check:ui-controls",
    "check:static": "pnpm test:tooling && pnpm check:source-limits && pnpm test:source-limits && pnpm policy:static && pnpm typecheck && pnpm lint && pnpm format:check && pnpm build:all && pnpm build-storybook",
    "test": "node scripts/run-tooling.mjs pnpm --filter @recall/verification test",
    "test:integration": "node scripts/run-tooling.mjs pnpm --filter @recall/verification test:integration",
    "test:local-integration": "node scripts/run-tooling.mjs pnpm --filter @recall/verification test:local-integration",
    "test:e2e": "node scripts/run-tooling.mjs pnpm --filter web test:e2e",
    "check:pure": "pnpm test && pnpm test:local-integration && pnpm check:static",
    "check": "pnpm test && pnpm test:local-integration && pnpm test:integration && pnpm check:static",
    "test:code-runner": "pnpm --filter @recall/verification test:code-runner",
    "contracts:generate": "pnpm --filter @recall/verification contracts:generate",
    "contracts:check": "pnpm --filter @recall/verification contracts:check",
    "test:tooling": "node --test scripts/run-tooling.test.mjs scripts/ui-control-policy.test.mjs",
    "tooling:memory": "node scripts/tooling-memory.mjs",
    "check:ui-controls": "node scripts/check-ui-controls.mjs",
    "test:ui-controls": "node --test scripts/ui-control-policy.test.mjs",
    "test:managed-ai-ledger": "node scripts/verify-managed-ai-ledger.mjs"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-neverthrow": "^1.1.4",
    "supabase": "2.119.0",
    "turbo": "2.11.7",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
