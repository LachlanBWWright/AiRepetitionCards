# Local Supabase OAuth providers. Keep real secrets in the ignored root .env file.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Optional isolated Lua activity executor (requires locally built Docker image)
RECALL_LUA_IMAGE=recall-lua-runner:1

# Managed AI is opt-in. Apply 20261105000000_managed_ai.sql and configure
# operator-owned deployments, routes, prices and per-account grants first.
# Set these on the API server (ASP.NET, or Next.js when used as API owner).
MANAGED_AI_ENABLED=false
ANTHROPIC_API_KEY=
# OPENAI_API_KEY and SUPABASE_SERVICE_ROLE_KEY are also server-only.
# No provider credentials belong in NEXT_PUBLIC_* or EXPO_PUBLIC_* settings.
